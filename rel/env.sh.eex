#!/bin/sh

# Sets and enables heart (recommended only in daemon mode)
# case  in
#   daemon*)
#     HEART_COMMAND="/bin/ "
#     export HEART_COMMAND
#     export ELIXIR_ERL_OPTIONS="-heart"
#     ;;
#   *)
#     ;;
# esac

# Set the release to work across nodes. If using the long name format like
# the one below (my_app@127.0.0.1), you need to also uncomment the
# RELEASE_DISTRIBUTION variable below.
# export RELEASE_DISTRIBUTION=name

export LANG=C.UTF-8
export RELEASE_DISTRIBUTION="name"
export RELEASE_COOKIE="$"
export RELEASE_NODE="$-${NODE_ROLE:-default}@127.0.0.1"
export ERL_CRASH_DUMP="/tmp/mass-refactor-framework-595c748868-wkdkg-9460b4ad-9c9d-40ff-bf23-a3a0318dfc6d_crash.dump"

if [ ! -z "1" -a -z "" ]; then
  # set up an automatic scheduler limit, based on the request

  EXTRA_SCHEDULERS=$(((1+4-1)/4)) # ceil(1*0.25)
  K8S_CPU_LIMIT=$((1 + ))
fi

if [ ! -z "" ]; then # set either via above or injected by k8s from resource
  case  in
    start*|daemon*)
      export ELIXIR_ERL_OPTIONS=" +S :"
      ;;
    *)
      ;;
  esac
fi
